CREATE OR REPLACE FUNCTION fn_buscar_colaboradores(
    p_termo TEXT
)
RETURNS TABLE (
    id_colaborador INTEGER,
    nome VARCHAR(100),
    email VARCHAR(100),
    ativo BOOLEAN
)
LANGUAGE plpgsql
AS $$
BEGIN


    RETURN QUERY


    SELECT
        c.id_colaborador,
        c.nome,
        c.email,
        c.ativo


    FROM colaboradores c


    WHERE
        c.nome ILIKE '%' || p_termo || '%'
        OR
        c.email ILIKE '%' || p_termo || '%';


END;
$$;




CREATE OR REPLACE FUNCTION fn_validar_tarefa()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN




    IF NOT EXISTS (
        SELECT 1
        FROM colaboradores
        WHERE id_colaborador = NEW.id_colaborador
        AND ativo = TRUE
    ) THEN


        RAISE EXCEPTION
        'Erro: tarefa deve estar vinculada a um colaborador ativo.';


    END IF;






    NEW.data_criacao := CURRENT_TIMESTAMP;




    RETURN NEW;


END;
$$;




CREATE TRIGGER trg_validar_tarefa


BEFORE INSERT ON tarefas


FOR EACH ROW


EXECUTE FUNCTION fn_validar_tarefa();




CREATE OR REPLACE FUNCTION fn_registrar_historico()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN


    INSERT INTO historico_tarefas (
        id_tarefa,
        descricao_acao,
        data_registro
    )


    VALUES (
        NEW.id_tarefa,
        'Tarefa criada: ' || NEW.titulo,
        CURRENT_TIMESTAMP
    );


    RETURN NEW;


END;
$$;




CREATE TRIGGER trg_registrar_historico


AFTER INSERT ON tarefas


FOR EACH ROW


EXECUTE FUNCTION fn_registrar_historico();




CREATE OR REPLACE VIEW vw_painel_principal AS


SELECT
    c.nome AS nome_colaborador,
    t.titulo AS titulo_tarefa,
    cat.nome_categoria AS categoria,
    t.prazo_entrega,
    t.status


FROM tarefas t


INNER JOIN colaboradores c
    ON t.id_colaborador = c.id_colaborador


INNER JOIN categorias cat
    ON t.id_categoria = cat.id_categoria;






CREATE OR REPLACE VIEW vw_cronograma_prazos AS


SELECT
    t.id_tarefa,
    t.titulo AS titulo_tarefa,
    t.status,
    t.prazo_entrega,


    (t.prazo_entrega - CURRENT_DATE)
        AS dias_restantes,


    c.nome AS nome_responsavel


FROM tarefas t


INNER JOIN colaboradores c
    ON t.id_colaborador = c.id_colaborador


ORDER BY
    t.prazo_entrega ASC,
    t.id_tarefa ASC;


