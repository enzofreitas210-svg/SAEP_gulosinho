DROP VIEW IF EXISTS vw_painel_principal CASCADE;


DROP TABLE IF EXISTS historico_tarefas CASCADE;
DROP TABLE IF EXISTS tarefas CASCADE;
DROP TABLE IF EXISTS categorias CASCADE;
DROP TABLE IF EXISTS colaboradores CASCADE;


DROP FUNCTION IF EXISTS fn_buscar_colaboradores(TEXT);
DROP FUNCTION IF EXISTS fn_validar_tarefa();
DROP FUNCTION IF EXISTS fn_registrar_historico();




CREATE TABLE colaboradores (
    id_colaborador SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    senha VARCHAR(100) NOT NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE
);




CREATE TABLE categorias (
    id_categoria SERIAL PRIMARY KEY,
    nome_categoria VARCHAR(100) NOT NULL UNIQUE,
    descricao TEXT
);




CREATE TABLE tarefas (
    id_tarefa SERIAL PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    descricao TEXT,
    id_colaborador INTEGER NOT NULL,
    id_categoria INTEGER NOT NULL,
    data_criacao TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    prazo_entrega DATE NOT NULL,
    status VARCHAR(30) NOT NULL DEFAULT 'Pendente',


    CONSTRAINT fk_tarefa_colaborador
        FOREIGN KEY (id_colaborador)
        REFERENCES colaboradores(id_colaborador),


    CONSTRAINT fk_tarefa_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES categorias(id_categoria),


    CONSTRAINT chk_status
        CHECK (status IN (
            'Pendente',
            'Em andamento',
            'Concluida',
            'Cancelada'
        )),


    CONSTRAINT chk_prazo
        CHECK (prazo_entrega >= DATE '2020-01-01')
);




CREATE TABLE historico_tarefas (
    id_historico SERIAL PRIMARY KEY,
    id_tarefa INTEGER NOT NULL,
    descricao_acao TEXT NOT NULL,
    data_registro TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,


    CONSTRAINT fk_historico_tarefa
        FOREIGN KEY (id_tarefa)
        REFERENCES tarefas(id_tarefa)
        ON DELETE CASCADE
);




